+    av1_tu_trace_mark_failed((AV1_COMP *)cpi); return;
+  }
+  AOM_TU_TRACE_RECORD r; memset(&r, 0, sizeof(r));
+  const AV1_COMMON *cm = &cpi->common; const MACROBLOCKD *xd = &x->e_mbd;
+  r.generation = cpi->tu_trace.generation;
+  r.frame_number = cm->current_frame.frame_number;
+  r.order_hint = cm->current_frame.order_hint;
+  r.refresh_frame_flags = cm->current_frame.refresh_frame_flags;
