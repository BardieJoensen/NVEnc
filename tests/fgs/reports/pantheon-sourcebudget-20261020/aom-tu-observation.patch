+static void trace_tu(const AV1_COMP *cpi, MACROBLOCK *x, int block,
+                     int blk_row, int blk_col, BLOCK_SIZE plane_bsize,
+                     TX_SIZE tx_size, TX_TYPE tx_type, int status,
