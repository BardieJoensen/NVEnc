+static void trace_copy_plane(const uint8_t *src, ptrdiff_t stride, int hbd,
+                             int w, int h, uint16_t *dst) {
+  if (hbd) {
+    const uint16_t *s = CONVERT_TO_SHORTPTR(src);
+    for (int y = 0; y < h; ++y)
+      memcpy(dst + y * MAX_TX_SIZE, s + y * stride, (size_t)w * sizeof(*dst));
+  } else {
+    for (int y = 0; y < h; ++y) {
+      const uint8_t *s = src + y * stride;
+      for (int x = 0; x < w; ++x) dst[y * MAX_TX_SIZE + x] = s[x];
+    }
+  }
+}
+
+static void trace_md5_u16(const uint16_t *src, int w, int h, uint8_t out[16]) {
+  MD5Context m;
+  MD5Init(&m);
+  for (int y = 0; y < h; ++y)
+    MD5Update(&m, (const md5byte *)(src + y * MAX_TX_SIZE),
+              (unsigned)(w * sizeof(*src)));
+  MD5Final(out, &m);
+}
+
+static void trace_pack_rows(const uint16_t *src, int w, int h, uint16_t *dst) {
+  for (int y = 0; y < h; ++y) memcpy(dst + (size_t)y * w,
+                                      src + (size_t)y * MAX_TX_SIZE,
+                                      (size_t)w * sizeof(*dst));
+}
+static void trace_md5_bytes(const void *src, size_t n, uint8_t out[16]) {
+  MD5Context m; MD5Init(&m); MD5Update(&m, (const md5byte *)src, (unsigned)n); MD5Final(out, &m);
+}
+static void trace_inverse(const AV1_COMMON *cm, const MACROBLOCKD *xd,
+                          const uint16_t *pred, const tran_low_t *dq, int eob,
+                          TX_TYPE tx_type, TX_SIZE tx_size, int hbd,
+                          uint8_t *storage, uint16_t *out) {
+  if (hbd) {
+    uint16_t *v = (uint16_t *)storage;
+    for (int y = 0; y < MAX_TX_SIZE; ++y)
+      memcpy(v + (size_t)y * MAX_TX_SIZE, pred + (size_t)y * MAX_TX_SIZE,
+             MAX_TX_SIZE * sizeof(*v));
+    av1_inverse_transform_block(xd, dq, 0, tx_type, tx_size,
+                                CONVERT_TO_BYTEPTR(v), MAX_TX_SIZE, eob,
+                                cm->features.reduced_tx_set_used);
+  } else {
+    for (int y = 0; y < MAX_TX_SIZE; ++y)
+      for (int x = 0; x < MAX_TX_SIZE; ++x)
+        storage[(size_t)y * MAX_TX_SIZE + x] =
+            (uint8_t)AOMMIN(pred[(size_t)y * MAX_TX_SIZE + x], 255);
+    av1_inverse_transform_block(xd, dq, 0, tx_type, tx_size, storage,
+                                MAX_TX_SIZE, eob,
+                                cm->features.reduced_tx_set_used);
+  }
+  if (hbd) {
+    const uint16_t *v = (const uint16_t *)storage;
+    for (int y = 0; y < MAX_TX_SIZE; ++y)
+      memcpy(out + (size_t)y * MAX_TX_SIZE, v + (size_t)y * MAX_TX_SIZE,
+             MAX_TX_SIZE * sizeof(*out));
+  } else {
+    for (int y = 0; y < MAX_TX_SIZE; ++y)
+      for (int x = 0; x < MAX_TX_SIZE; ++x)
+        out[(size_t)y * MAX_TX_SIZE + x] = storage[(size_t)y * MAX_TX_SIZE + x];
+  }
+}
+static int trace_validate_eob(const tran_low_t *v, int n, uint16_t eob,
+                              const SCAN_ORDER *scan) {
+  uint16_t last = 0;
+  for (int i = 0; i < n; ++i) {
+    if (v[scan->scan[i]] != 0) last = (uint16_t)(i + 1);
+    if (i >= eob && v[scan->scan[i]] != 0) return 0;
+  }
+  return last == eob;
+}
