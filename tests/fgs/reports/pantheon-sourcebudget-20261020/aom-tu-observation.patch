+  r.tx_size = tx_size; r.tx_type = tx_type; r.block_size = plane_bsize;
+  r.qindex = raw ? x->qindex : -1; r.coded_qindex = raw ? xd->mi[0]->current_qindex : -1;
+  r.lossless = xd->lossless[xd->mi[0]->segment_id];
+  r.reduced_tx_set = cm->features.reduced_tx_set_used;
+  r.log_scale = av1_get_tx_scale(tx_size);
+  r.base_qindex = cm->quant_params.base_qindex;
+  r.segment_id = xd->mi[0]->segment_id; r.delta_q = x->delta_qindex;
+  r.quant_idx = (uint32_t)quant_idx; r.quant_flags = (uint32_t)quant_flags;
+  const struct macroblock_plane *qp = &x->plane[0];
+  r.dequant_dc = qp->dequant_QTX[0]; r.dequant_ac = qp->dequant_QTX[1];
+  r.zbin_dc = qp->zbin_QTX[0]; r.zbin_ac = qp->zbin_QTX[1];
+  r.round_dc = (quant_idx == AV1_XFORM_QUANT_B ? qp->round_QTX : qp->round_fp_QTX)[0];
+  r.round_ac = (quant_idx == AV1_XFORM_QUANT_B ? qp->round_QTX : qp->round_fp_QTX)[1];
+  r.quant_dc = (quant_idx == AV1_XFORM_QUANT_B ? qp->quant_QTX : qp->quant_fp_QTX)[0];
+  r.quant_ac = (quant_idx == AV1_XFORM_QUANT_B ? qp->quant_QTX : qp->quant_fp_QTX)[1];
+  r.quant_shift_dc = qp->quant_shift_QTX[0]; r.quant_shift_ac = qp->quant_shift_QTX[1];
+  r.delta_q = x->delta_qindex; r.eob_initial = eob_initial;
+  r.eob_final = eob_final; r.coeff_count = (uint32_t)n;
+  r.skip_flags = (uint32_t)(xd->mi[0]->skip_mode << 1);
+  r.source_index = cpi->tu_trace.source_index;
+  memcpy(r.source_md5, cpi->tu_trace.source_md5, sizeof(r.source_md5));
+  trace_md5_u16(pred, r.width, r.height, r.predictor_md5);
+  trace_md5_u16(recon, r.width, r.height, r.preloop_md5);
+  if (residual) trace_md5_bytes(residual, (size_t)r.width * r.height * sizeof(*residual), r.residual_md5);
+  DECLARE_ALIGNED(32, uint8_t, scratch_storage[2 * MAX_TX_SQUARE]);
+  DECLARE_ALIGNED(32, uint16_t, scratch_maps[3][MAX_TX_SQUARE]);
+  DECLARE_ALIGNED(32, uint16_t, packed_maps[4][MAX_TX_SQUARE]);
+  const int hbd = is_cur_buf_hbd(xd); uint16_t raw_eob = 0;
+  const SCAN_ORDER *scan = get_scan(tx_size, tx_type);
+  for (int i = 0; i < n; i++) {
+    if (scan->scan[i] < 0 || scan->scan[i] >= n) {
+      av1_tu_trace_mark_failed((AV1_COMP *)cpi); return;
+    }
+  }
+  if (raw) {
+    for (int i = 0; i < n; ++i)
+      if (raw[scan->scan[i]] != 0) raw_eob = (uint16_t)(i + 1);
+  }
+  if ((raw && !trace_validate_eob(raw, n, raw_eob, scan)) ||
+      (initial_q && !trace_validate_eob(initial_q, n, eob_initial, scan)) ||
+      (initial_dq && !trace_validate_eob(initial_dq, n, eob_initial, scan)) ||
+      (final_q && !trace_validate_eob(final_q, n, eob_final, scan)) ||
+      (final_dq && !trace_validate_eob(final_dq, n, eob_final, scan))) {
+    av1_tu_trace_mark_failed((AV1_COMP *)cpi);
+    return;
+  }
+  r.raw_eob = raw_eob;
+  const tran_low_t *domains[3] = { final_dq, initial_dq, raw };
+  for (int i=0;i<3;i++) {
+    if (domains[i]) trace_inverse(cm, xd, pred, domains[i], i==0?eob_final:(i==1?eob_initial:raw_eob), tx_type, tx_size, hbd, scratch_storage, scratch_maps[i]);
+    else memcpy(scratch_maps[i], pred, sizeof(scratch_maps[i]));
+    trace_pack_rows(scratch_maps[i], r.width, r.height, packed_maps[i]);
+  }
+  trace_pack_rows(pred, r.width, r.height, packed_maps[3]);
+  if (final_dq) {
+    for (int y=0;y<r.height;y++) if(memcmp(scratch_maps[0]+(size_t)y*MAX_TX_SIZE,recon+(size_t)y*MAX_TX_SIZE,(size_t)r.width*sizeof(uint16_t))) { av1_tu_trace_mark_failed((AV1_COMP *)cpi); return; }
+    r.flags |= AOM_TU_TRACE_HAS_SCRATCH;
+  }
+  if (!raw) { r.tx_size = r.tx_type = -1; }
+  r.flags |= AOM_TU_TRACE_HAS_MAPS | (raw?AOM_TU_TRACE_HAS_RAW:0) |
+             (initial_q?AOM_TU_TRACE_HAS_INITIAL:0) | (final_q?AOM_TU_TRACE_HAS_FINAL:0);
+  const size_t coeff_bytes=(size_t)n*sizeof(tran_low_t), map_bytes=(size_t)r.width*r.height*sizeof(uint16_t);
+  av1_tu_trace_write_tu((AV1_COMP *)cpi,&r,raw,initial_q,initial_dq,final_q,final_dq,
+                        packed_maps[0],packed_maps[1],packed_maps[2],packed_maps[3],residual,
+                        n ? scan->scan : NULL,coeff_bytes,map_bytes);
+  (void)block;
+}
