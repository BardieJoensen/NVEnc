+#if __BYTE_ORDER__ != __ORDER_LITTLE_ENDIAN__
+#error "Private trace requires little endian"
+#endif
+_Static_assert(sizeof(tran_low_t) == 4, "coefficient ABI");
+_Static_assert(sizeof(AOM_TU_TRACE_RECORD) == 228, "TU metadata ABI");
+static const uint8_t target_md5[16] = {
+  0x94,0xfa,0x8b,0xde,0x34,0x6a,0x2a,0x52,
+  0xd4,0x0b,0x26,0xf8,0x18,0x3a,0xfe,0xa5
+};
+typedef struct __attribute__((packed)) Envelope {
+  uint32_t magic, schema, type, length;
+  uint64_t generation;
+} Envelope;
+typedef struct __attribute__((packed)) Header {
+  uint32_t width, height, bit_depth, subsampling;
+  uint64_t generation, source_index;
+  uint8_t source_md5[16], coding_source_md5[16];
+  uint32_t frame_type, show_frame, showable_frame, order_hint;
+  uint32_t refresh_frame_flags, gf_index, update_type, parallel_level;
+} Header;
+typedef struct __attribute__((packed)) Final {
+  uint64_t generation, packet_size, frame_number, order_hint;
+  uint32_t width, height, refresh_frame_flags, show_frame;
+  uint8_t source_md5[16], packet_md5[16], preloop_md5[16], postloop_md5[16];
+} Final;
+_Static_assert(sizeof(Envelope) == 24, "envelope ABI");
+_Static_assert(sizeof(Header) == 96, "header ABI");
+_Static_assert(sizeof(Final) == 112, "final ABI");
+
+static void digest(const void *p, size_t n, uint8_t out[16]) {
+  MD5Context m;
+  MD5Init(&m);
+  MD5Update(&m, (const md5byte *)p, (unsigned)n);
+  MD5Final(out, &m);
+}
+static int write_all(AOM_TU_TRACE_STATE *s, const void *buffer, size_t n) {
+  if (s->io_error || s->bytes > AOM_TU_TRACE_CAP ||
+      n > AOM_TU_TRACE_CAP - s->bytes) {
+    s->io_error = 1;
+    return 0;
+  }
+  const uint8_t *p = buffer;
+  while (n) {
+    ssize_t written = write(s->fd, p, n);
+    if (written < 0 && errno == EINTR) continue;
+    if (written <= 0) { s->io_error = 1; return 0; }
+    p += written;
+    n -= (size_t)written;
+    s->bytes += (uint64_t)written;
+  }
+  return 1;
+}
+static int record(AOM_TU_TRACE_STATE *s, uint32_t kind,
+                  uint64_t generation, const void *p, size_t n) {
+  if (n > UINT32_MAX || n + sizeof(Envelope) > AOM_TU_TRACE_CAP - s->bytes) {
+    s->io_error = 1;
+    return 0;
+  }
+  const Envelope e = { AOM_TU_TRACE_MAGIC, AOM_TU_TRACE_SCHEMA,
+                       kind, (uint32_t)n, generation };
+  return write_all(s, &e, sizeof(e)) && write_all(s, p, n);
+}
+static void update_plane(MD5Context *m, const uint8_t *p, int stride,
+                         int width, int height, int highbd) {
+  if (highbd) {
+    const uint16_t *samples = CONVERT_TO_SHORTPTR(p);
+    for (int y = 0; y < height; y++)
+      MD5Update(m, (const md5byte *)(samples + (ptrdiff_t)y * stride), width * 2);
+  } else {
+    for (int y = 0; y < height; y++)
+      MD5Update(m, p + (ptrdiff_t)y * stride, width);
+  }
+}
+static void frame_digest(const YV12_BUFFER_CONFIG *f, uint8_t out[16]) {
+  MD5Context m;
+  MD5Init(&m);
+  const int highbd = !!(f->flags & YV12_FLAG_HIGHBITDEPTH);
+  update_plane(&m, f->y_buffer, f->y_stride, f->y_crop_width, f->y_crop_height, highbd);
+  update_plane(&m, f->u_buffer, f->uv_stride, f->uv_crop_width, f->uv_crop_height, highbd);
+  update_plane(&m, f->v_buffer, f->uv_stride, f->uv_crop_width, f->uv_crop_height, highbd);
+  MD5Final(out, &m);
+}
+static void copy_luma(const YV12_BUFFER_CONFIG *f, uint16_t *out) {
+  const uint16_t *p = CONVERT_TO_SHORTPTR(f->y_buffer);
+  for (int y = 0; y < 1080; y++)
+    memcpy(out + (size_t)y * 1920, p + (ptrdiff_t)y * f->y_stride, 1920 * 2);
+}
+static int valid_geometry(const YV12_BUFFER_CONFIG *f) {
+  return f && f->y_crop_width == 1920 && f->y_crop_height == 1080 &&
+      f->uv_crop_width == 960 && f->uv_crop_height == 540 &&
+      f->subsampling_x == 1 && f->subsampling_y == 1 &&
+      (f->flags & YV12_FLAG_HIGHBITDEPTH) && f->y_stride >= 1920 && f->uv_stride >= 960;
+}
+void av1_tu_trace_init(AOM_TU_TRACE_STATE *s) {
+  memset(s, 0, sizeof(*s));
+  s->fd = -1;
+  if (pthread_mutex_init(&s->mutex, NULL)) abort();
+}
+void av1_tu_trace_destroy(AOM_TU_TRACE_STATE *s) {
+  free(s->preloop_plane);
+  pthread_mutex_destroy(&s->mutex);
+}
+void av1_tu_trace_begin(AV1_COMP *cpi, uint64_t generation, int exploratory) {
+  AOM_TU_TRACE_STATE *s = &cpi->tu_trace;
+  pthread_mutex_lock(&s->mutex);
+  s->active = s->target_active = 0;
+  s->generation = generation;
+  s->source_index = UINT64_MAX;
+  s->preloop_w = s->preloop_h = 0;
+  const char *env = getenv("AOM_TU_TRACE_FD");
+  if (exploratory || !env || !*env || !cpi->unscaled_source) goto done;
+  char *end = NULL;
+  errno = 0;
+  long fd = strtol(env, &end, 10);
+  if (errno || end == env || *end || fd < 0 || fd > INT_MAX) goto fail;
+  const int flags = fcntl((int)fd, F_GETFL);
+  if (flags < 0 || (flags & O_ACCMODE) == O_RDONLY || !(flags & O_APPEND)) goto fail;
+  s->fd = (int)fd;
+  frame_digest(cpi->unscaled_source, s->source_md5);
+  if (memcmp(s->source_md5, target_md5, 16)) goto done;
+  const AV1_COMMON *cm = &cpi->common;
+  const GF_GROUP *gf = &cpi->ppi->gf_group;
+  if (!valid_geometry(cpi->unscaled_source) || !valid_geometry(cpi->source) ||
+      !valid_geometry(&cm->cur_frame->buf) || cm->seq_params->bit_depth != 10 ||
+      cm->width != 1920 || cm->height != 1080 ||
+      cm->superres_scale_denominator != SCALE_NUMERATOR ||
+      cpi->oxcf.superres_cfg.superres_mode != AOM_SUPERRES_NONE ||
+      cpi->mt_info.pipeline_lpf_mt_with_enc || cm->quant_params.using_qmatrix ||
+      cm->features.allow_intrabc || gf->frame_parallel_level[cpi->gf_frame_index] != 0)
+    goto fail;
+  Header h = { 0 };
+  h.width = 1920; h.height = 1080; h.bit_depth = 10; h.subsampling = 257;
+  h.generation = generation; h.source_index = 216;
+  memcpy(h.source_md5, s->source_md5, 16);
+  frame_digest(cpi->source, h.coding_source_md5);
+  if (memcmp(h.source_md5, h.coding_source_md5, 16)) goto fail;
+  h.frame_type = cm->current_frame.frame_type;
+  h.show_frame = cm->show_frame; h.showable_frame = cm->showable_frame;
+  h.order_hint = cm->current_frame.order_hint;
+  h.refresh_frame_flags = cm->current_frame.refresh_frame_flags;
+  h.gf_index = cpi->gf_frame_index; h.update_type = gf->update_type[cpi->gf_frame_index];
+  h.parallel_level = gf->frame_parallel_level[cpi->gf_frame_index];
+  s->source_index = 216;
+  s->active = s->target_active = 1;
+  if (!record(s, AOM_TU_TRACE_HEADER, generation, &h, sizeof(h))) s->active = 0;
+  goto done;
+fail:
+  s->io_error = 1;
+done:
+  pthread_mutex_unlock(&s->mutex);
+}
+void av1_tu_trace_end_attempt(AV1_COMP *cpi, uint64_t generation) {
+  AOM_TU_TRACE_STATE *s = &cpi->tu_trace;
+  pthread_mutex_lock(&s->mutex);
+  if (s->active) {
+    if (s->generation != generation || !s->target_active) s->io_error = 1;
+    else record(s, AOM_TU_TRACE_ATTEMPT_END, generation, &generation, sizeof(generation));
+  }
+  s->active = 0;
+  pthread_mutex_unlock(&s->mutex);
+}
+void av1_tu_trace_snapshot_preloop(AV1_COMP *cpi) {
+  AOM_TU_TRACE_STATE *s = &cpi->tu_trace;
+  pthread_mutex_lock(&s->mutex);
+  if (s->target_active && !s->io_error) {
+    const YV12_BUFFER_CONFIG *f = &cpi->common.cur_frame->buf;
+    if (!valid_geometry(f) || s->active) s->io_error = 1;
+    else {
+      if (!s->preloop_plane) s->preloop_plane = malloc(1920 * 1080 * 2);
+      if (!s->preloop_plane) s->io_error = 1;
+      else {
+        copy_luma(f, s->preloop_plane);
+        digest(s->preloop_plane, 1920 * 1080 * 2, s->preloop_md5);
+        s->preloop_w = 1920; s->preloop_h = 1080;
+      }
+    }
+  }
+  pthread_mutex_unlock(&s->mutex);
+}
+void av1_tu_trace_frame_final(AV1_COMP *cpi, uint64_t generation,
+                            const uint8_t *packet, size_t packet_size) {
+  AOM_TU_TRACE_STATE *s = &cpi->tu_trace;
+  pthread_mutex_lock(&s->mutex);
+  if (!s->target_active || s->io_error) goto done;
+  const YV12_BUFFER_CONFIG *f = &cpi->common.cur_frame->buf;
+  if (s->generation != generation || s->active || !valid_geometry(f) ||
+      s->preloop_w != 1920 || s->preloop_h != 1080 || !s->preloop_plane ||
+      packet_size > UINT_MAX) { s->io_error = 1; goto done; }
+  const size_t plane_bytes = 1920 * 1080 * 2;
+  const size_t n = sizeof(Final) + 2 * plane_bytes + packet_size;
+  uint8_t *buffer = malloc(n);
+  if (!buffer) { s->io_error = 1; goto done; }
+  Final h = { 0 };
+  h.generation = generation; h.packet_size = packet_size;
+  h.frame_number = cpi->common.current_frame.frame_number;
+  h.order_hint = cpi->common.current_frame.order_hint;
+  h.width = 1920; h.height = 1080;
+  h.refresh_frame_flags = cpi->common.current_frame.refresh_frame_flags;
+  h.show_frame = cpi->common.show_frame;
+  memcpy(h.source_md5, s->source_md5, 16);
+  digest(packet, packet_size, h.packet_md5);
+  memcpy(h.preloop_md5, s->preloop_md5, 16);
+  memcpy(buffer + sizeof(h), s->preloop_plane, plane_bytes);
+  copy_luma(f, (uint16_t *)(buffer + sizeof(h) + plane_bytes));
+  digest(buffer + sizeof(h) + plane_bytes, plane_bytes, h.postloop_md5);
+  memcpy(buffer, &h, sizeof(h));
+  memcpy(buffer + sizeof(h) + 2 * plane_bytes, packet, packet_size);
+  record(s, AOM_TU_TRACE_FRAME_FINAL, generation, buffer, n);
+  free(buffer);
+done:
+  s->active = s->target_active = 0;
+  pthread_mutex_unlock(&s->mutex);
+}
+int av1_tu_trace_failed(const AV1_COMP *cpi) { return cpi->tu_trace.io_error; }
+void av1_tu_trace_mark_failed(AV1_COMP *cpi) {
+  pthread_mutex_lock(&cpi->tu_trace.mutex);
+  cpi->tu_trace.io_error = 1;
+  pthread_mutex_unlock(&cpi->tu_trace.mutex);
+}
+void av1_tu_trace_write_region(AV1_COMP *cpi, int mi_row, int mi_col,
+                              int width, int height, int block_size,
+                              const uint16_t *pred, size_t map_bytes) {
+  AOM_TU_TRACE_RECORD r = { 0 };
+  r.generation = cpi->tu_trace.generation;
+  r.frame_number = cpi->common.current_frame.frame_number;
+  r.order_hint = cpi->common.current_frame.order_hint;
+  r.refresh_frame_flags = cpi->common.current_frame.refresh_frame_flags;
+  r.show_frame = cpi->common.show_frame; r.bit_depth = 10;
+  r.status = AOM_TU_TRACE_CODING_BLOCK_SKIP;
+  r.blk_row = mi_row * MI_SIZE; r.blk_col = mi_col * MI_SIZE;
+  r.width = width; r.height = height;
+  r.tx_size = r.tx_type = r.qindex = r.coded_qindex = -1;
+  r.quant_idx = UINT32_MAX; r.block_size = block_size;
+  r.source_index = 216; r.flags = AOM_TU_TRACE_HAS_MAPS;
+  memcpy(r.source_md5, cpi->tu_trace.source_md5, 16);
+  digest(pred, map_bytes, r.predictor_md5);
+  memcpy(r.preloop_md5, r.predictor_md5, 16);
+  av1_tu_trace_write_tu(cpi, &r, NULL, NULL, NULL, NULL, NULL,
+                       pred, pred, pred, pred, NULL, NULL, 0, map_bytes);
+}
+void av1_tu_trace_write_tu(AV1_COMP *cpi, const AOM_TU_TRACE_RECORD *r,
+                          const void *raw, const void *iq, const void *idq,
+                          const void *fq, const void *fdq, const void *final,
+                          const void *initial, const void *rawmap,
+                          const void *pred, const void *residual, const int16_t *scan,
+                          size_t coeff_bytes, size_t map_bytes) {
+  AOM_TU_TRACE_STATE *s = &cpi->tu_trace;
+  pthread_mutex_lock(&s->mutex);
+  if (!s->active || s->io_error) goto done;
+  if (r->generation != s->generation || r->source_index != 216 ||
+      !r->width || !r->height || r->width > 128 || r->height > 128 ||
+      r->blk_col >= 1920 || r->blk_row >= 1080 ||
+      map_bytes != (size_t)r->width * r->height * 2 ||
+      coeff_bytes != r->coeff_count * sizeof(tran_low_t) ||
+      !final || !initial || !rawmap || !pred ||
+      (coeff_bytes && (!raw || !iq || !idq || !fq || !fdq || !residual || !scan))) {
+    s->io_error = 1; goto done;
+  }
+  const size_t scan_bytes = r->coeff_count * sizeof(int16_t);
+  const size_t residual_bytes = coeff_bytes ? map_bytes : 0;
+  const size_t n = sizeof(*r) + 5 * coeff_bytes + scan_bytes + 4 * map_bytes + residual_bytes;
+  uint8_t *buffer = malloc(n);
+  if (!buffer) { s->io_error = 1; goto done; }
+  memcpy(buffer, r, sizeof(*r));
+  size_t offset = sizeof(*r);
+  const void *vectors[5] = { raw, iq, idq, fq, fdq };
+  for (int i = 0; i < 5; i++) {
+    if (coeff_bytes) memcpy(buffer + offset, vectors[i], coeff_bytes);
+    offset += coeff_bytes;
+  }
+  if (scan_bytes) memcpy(buffer + offset, scan, scan_bytes);
+  offset += scan_bytes;
+  const void *maps[4] = { final, initial, rawmap, pred };
+  for (int i = 0; i < 4; i++) { memcpy(buffer + offset, maps[i], map_bytes); offset += map_bytes; }
+  if (residual_bytes) memcpy(buffer + offset, residual, residual_bytes);
+  record(s, AOM_TU_TRACE_TU, r->generation, buffer, n);
+  free(buffer);
+done:
+  pthread_mutex_unlock(&s->mutex);
+}
