+void r18_apply_selected_sb_cap(PictureControlSet *pcs, unsigned recode) {
+    if (!r18_cap_enabled(pcs)) return;
+    SequenceControlSet *scs = pcs->scs;
+    PictureParentControlSet *ppcs = pcs->ppcs;
+    r18_require(scs->sb_size == 64 && scs->seq_header.sb_size == BLOCK_64X64,
+                "unsupported SB geometry");
+    r18_require(scs->static_config.source_width == 1920 &&
+                scs->static_config.source_height == 1080 &&
+                scs->static_config.encoder_bit_depth == 10 &&
+                scs->static_config.encoder_color_format == 1 &&
+                pcs->frame_width == 1920 && pcs->sb_total_count == 510 &&
+                ppcs->av1_cm->frm_size.frame_width == 1920 &&
+                ppcs->av1_cm->frm_size.frame_height == 1080,
