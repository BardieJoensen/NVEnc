+static void r18_fail(const char *why) {
+    fprintf(stderr, "PANTHEON_R18_CAP_FATAL: %s\n", why);
+    _Exit(86);
+}
+
+static void r18_require(bool condition, const char *why) {
+    if (!condition) r18_fail(why);
+}
+
+static bool r18_cap_enabled(const PictureControlSet *pcs) {
+    const char *v = getenv("SVT_PANTHEON_R18_CAP");
+    if (!v || strcmp(v, "1")) return false;
+    r18_require(pcs && pcs->scs, "missing picture/sequence control");
+    r18_require(pcs->scs->static_config.pass == ENC_SECOND_PASS,
+                "cap requested outside second pass");
+    r18_require(!pcs->pic_bypass_encdec, "cap requested on bypass EncDec picture");
+    return true;
+}
