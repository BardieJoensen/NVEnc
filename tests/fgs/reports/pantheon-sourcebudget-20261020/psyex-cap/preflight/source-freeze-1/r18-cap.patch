+                "segmentation ALT-Q is enabled");
+    const unsigned old_present = ppcs->frm_hdr.delta_q_params.delta_q_present;
+    const unsigned old_res = ppcs->frm_hdr.delta_q_params.delta_q_res;
+    const unsigned old_base = ppcs->frm_hdr.quantization_params.base_q_idx;
+    const unsigned old_lambda = ppcs->blk_lambda_tuning;
+    const unsigned old_picture_qp = pcs->picture_qp;
+    const unsigned old_parent_qp = ppcs->picture_qp;
+    const unsigned old_public_qp = scs->static_config.qp;
+    PbCapEntry entries[28]; unsigned count = 0; uint8_t before[510];
+    bool selected[510] = {false};
+    for (unsigned i = 0; i < pcs->sb_total_count; ++i) {
+        r18_require(pcs->sb_ptr_array[i] &&
+                    pcs->sb_ptr_array[i]->org_x == (i % 30) * 64 &&
+                    pcs->sb_ptr_array[i]->org_y == (i / 30) * 64,
+                    "SB geometry/ID mismatch");
+        before[i] = pcs->sb_ptr_array[i]->qindex;
+    }
+    for (unsigned i = 0; i < pcs->sb_total_count; ++i) {
+        SuperBlock *sb = pcs->sb_ptr_array[i];
+        const unsigned x = sb->org_x, y = sb->org_y;
+        const bool hit = (x < 1400 && x + 64 > 1200 && y < 750 && y + 64 > 650) ||
+                         (x < 1200 && x + 64 > 950 && y < 230 && y + 64 > 50);
+        const unsigned pre = sb->qindex;
+        if (!hit) continue;
+        r18_require(count < 28, "selected SB count exceeds 28");
+        entries[count++] = (PbCapEntry){.sb=i,.x=x,.y=y,.pre_qindex=pre,
+            .post_qindex=pre > 4 ? 4 : pre,.selected=1,.lambda_refreshed=0};
+        r18_require(entries[count-1].post_qindex != 0, "selected SB normalized to lossless qindex");
+        selected[i] = true;
+        sb->qindex = (uint8_t)entries[count-1].post_qindex;
+    }
+    r18_require(count == 28, "fixed ROI did not select exactly 28 SBs");
+    for (unsigned i = 0; i < pcs->sb_total_count; ++i) {
+        if (!selected[i]) r18_require(pcs->sb_ptr_array[i]->qindex == before[i],
+                                    "unselected SB qindex changed");
+    }
+    pcs->ppcs->frm_hdr.delta_q_params.delta_q_present = 1;
+    pcs->ppcs->frm_hdr.delta_q_params.delta_q_res = 1;
+    /* Refresh an already active TPL lambda path. Do not enable a previously
+       inactive whole-picture path merely because the outer TPL gate was true. */
+    if (old_lambda) {
+        r18_require(scs->static_config.enable_adaptive_quantization == 2 &&
+                    ppcs->tpl_ctrls.enable && ppcs->r0 != 0 &&
+                    ppcs->r0_based_qps_qpm && ppcs->tpl_is_valid == 1 &&
+                    ppcs->pa_me_data && ppcs->enhanced_unscaled_pic &&
+                    ppcs->enhanced_unscaled_pic->width == 1920,
+                    "active lambda path lacks expected original TPL factors");
+        const unsigned step = ppcs->tpl_ctrls.synth_blk_size == 32 ? 32 : 16;
+        const unsigned cols = 1920 / step;
+        const unsigned rows = (ppcs->av1_cm->mi_rows * 4 + step - 1) / step;
+        const unsigned n = rows * cols;
+        r18_require(n && n <= 8160 && rows * step <= 1088, "TPL factor geometry");
+        double *const factors = ppcs->pa_me_data->tpl_sb_rdmult_scaling_factors;
+        double *const original = ppcs->pa_me_data->tpl_rdmult_scaling_factors;
+        r18_require(factors && original, "missing TPL arrays");
+        double *old_factors = malloc(n * sizeof(*old_factors));
+        double *old_original = malloc(n * sizeof(*old_original));
+        r18_require(old_factors && old_original, "TPL snapshot allocation");
+        memcpy(old_factors, factors, n * sizeof(*old_factors));
+        memcpy(old_original, original, n * sizeof(*old_original));
+        for (unsigned i = 0; i < count; ++i) {
+            sb_setup_lambda(pcs, pcs->sb_ptr_array[entries[i].sb]);
+            entries[i].lambda_refreshed = 1;
+        }
+        r18_require(!memcmp(old_original, original, n * sizeof(*old_original)),
+                    "original TPL factors changed");
+        for (unsigned i = 0; i < n; ++i) {
+            const unsigned x = (i % cols) * step, y = (i / cols) * step;
+            const unsigned sb = (y / 64) * 30 + x / 64;
+            r18_require(sb < 510, "TPL factor outside SB domain");
+            if (selected[sb]) {
+                r18_require(isfinite(factors[i]) && factors[i] > 0 &&
+                            isfinite(original[i]) && original[i] > 0,
