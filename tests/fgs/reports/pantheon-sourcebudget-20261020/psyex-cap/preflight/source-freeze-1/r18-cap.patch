+                pcs->picture_qp == old_picture_qp && ppcs->picture_qp == old_parent_qp &&
+                scs->static_config.qp == old_public_qp,
+                "cap changed frame/public QP or lambda activation");
+    pb_cap_application(pcs, ppcs->loop_count, recode, 1, entries, count,
+                       old_present, old_res, old_base, old_lambda);
+}
