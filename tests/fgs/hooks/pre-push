#!/bin/bash
# Install: ln -s ../../tests/fgs/hooks/pre-push .git/hooks/pre-push
# Test every distinct commit being pushed, including non-HEAD refs and tags.
# FGS_PREPUSH=full includes real-film oracles and known-bad controls.
# FGS_PREPUSH=off explicitly skips GPU tests; pushed-commit CPU tests still run.
set -euo pipefail

REPO="$(git rev-parse --show-toplevel)"
MODE="${FGS_PREPUSH:-quick}"
case "$MODE" in
    quick|full|off) ;;
    *) echo "pre-push: invalid FGS_PREPUSH mode: $MODE" >&2; exit 2 ;;
esac

declare -A seen=()
commits=()
while read -r local_ref local_oid remote_ref remote_oid; do
    [[ "$local_oid" =~ ^0+$ ]] && continue
    commit="$(git -C "$REPO" rev-parse --verify "$local_oid^{commit}")" || exit 2
    if [ -z "${seen[$commit]:-}" ]; then
        commits+=("$commit")
        seen[$commit]=1
    fi
done
[ "${#commits[@]}" -gt 0 ] || exit 0

snapshot="$(mktemp -d "${TMPDIR:-/tmp}/fgs-prepush-XXXXXX")"
trap 'rm -rf -- "$snapshot"' EXIT
# Use the installed, committed GPU harness even for an older candidate. Older
# commits may have the faulty gate or lack its current command-line options.
harness_commit="$(git -C "$REPO" rev-parse HEAD)"
mkdir "$snapshot/harness"
git -C "$REPO" archive "$harness_commit" tests/fgs tools/fgs | tar -x -C "$snapshot/harness"
for commit in "${commits[@]}"; do
    tree="$snapshot/$commit"
    mkdir "$tree"
    git -C "$REPO" archive "$commit" tests/fgs NVEncCore NVEncSDK | tar -x -C "$tree"
    printf '\n== pre-push: CPU tests for %s\n' "$commit"
    TMPDIR="$tree" bash "$tree/tests/fgs/run_cpu_tests.sh"
    if [ "$MODE" = "off" ]; then
        echo "pre-push: FGS_PREPUSH=off; GPU tests skipped for $commit" >&2
        continue
    fi
    if ! command -v nvidia-smi >/dev/null 2>&1 || ! nvidia-smi -L >/dev/null 2>&1; then
        echo "pre-push: GPU tests cannot run here; run the full gate on the GPU host for $commit" >&2
        exit 1
    fi
    printf '\n== pre-push: %s GPU gate for %s\n' "$MODE" "$commit"
    FGS_GATE_REPO="$REPO" FGS_GATE_HARNESS_COMMIT="$harness_commit" \
        bash "$snapshot/harness/tests/fgs/local_gate.sh" \
        "--$MODE" --candidate-commit "$commit" --denoiser bilateral
done
printf '\npre-push: selected checks passed for every pushed commit.\n'
