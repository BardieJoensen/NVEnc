FROM ubuntu:20.04

ARG DEBIAN_FRONTEND=noninteractive \
    OSVER=ubuntu2004 \
    LOCAL_USER_ID=1000 \
    LOCAL_GROUP_ID=1000 \
    FFMPEG_DLL_REPO=https://github.com/rigaya/build_scripts.git \
    FFMPEG_DLL_REV=4d489561112417c9b51dd649915c86c00c003a59 \
    BUILD_SCRIPTS_DIR=/opt/build_scripts \
    NVENC_HEADER_DIR=/opt/nvenc_headers \
    AVISYNTH_HEADERS_URL=https://github.com/AviSynth/AviSynthPlus/archive/refs/tags/v3.7.5.tar.gz \
    VAPOURSYNTH_HEADERS_URL=https://github.com/vapoursynth/vapoursynth/archive/refs/tags/R72.tar.gz \
    VSHIP_HEADERS_URL=https://codeberg.org/Line-fr/Vship/archive/v5.0.0.tar.gz \
    FFMPEG_PREFIX=/opt/build_scripts/ffmpeg_dll/build_dll/x64/build \
    VMAF_PREFIX=/opt/build_scripts/ffmpeg_dll/x64/build \
    NASM_VERSION=2.16.03 \
    NASM_SHA256=1412a1c760bbd05db026b6c0d1657affd6631cd0a63cddb6f73cc6d4aa616148 \
    CUDA_VER_MAJOR=11 \
    CUDA_VER_MINOR=2 \
    CUDA_DEB_URL=https://developer.download.nvidia.com/compute/cuda/11.2.1/local_installers/cuda-repo-ubuntu2004-11-2-local_11.2.1-460.32.03-1_amd64.deb \
    CUDA_DEB_NAME=cuda-repo-ubuntu2004-11-2-local_11.2.1-460.32.03-1_amd64.deb \
    CUDA_PUB_PATH=/var/cuda-repo-ubuntu2004-11-2-local/7fa2af80.pub

RUN apt update \
    && apt-get install -y \
      wget \
      curl \
      git \
      ca-certificates \
      gnupg \
      lsb-release \
      autogen \
      autoconf \
      automake \
      libtool \
      autopoint \
      gettext \
      make \
      pkg-config \
      nasm \
      yasm \
      xxd \
      patch \
      xz-utils \
      p7zip-full \
      unzip \
      bzip2 \
      python3 \
      python3-pip \
      gperf \
      build-essential \
      libx11-dev \
      openssl \
      libssl-dev \
    && curl -fsSL "https://www.nasm.us/pub/nasm/releasebuilds/${NASM_VERSION}/nasm-${NASM_VERSION}.tar.xz" -o /tmp/nasm.tar.xz \
    && echo "${NASM_SHA256}  /tmp/nasm.tar.xz" | sha256sum -c - \
    && mkdir -p /tmp/nasm-src \
    && tar -xJf /tmp/nasm.tar.xz --strip-components=1 -C /tmp/nasm-src \
    && cd /tmp/nasm-src \
    && ./configure --prefix=/usr/local \
    && make -j"$(nproc)" \
    && make install \
    && cd / \
    && nasm -v \
    && rm -rf /tmp/nasm-src /tmp/nasm.tar.xz \
    && wget -O - https://apt.kitware.com/keys/kitware-archive-latest.asc \
      | gpg --dearmor \
      > /usr/share/keyrings/kitware-archive-keyring.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/kitware-archive-keyring.gpg] https://apt.kitware.com/ubuntu/ $(lsb_release -cs) main" \
      > /etc/apt/sources.list.d/kitware.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends cmake \
    && wget -q https://developer.download.nvidia.com/compute/cuda/repos/${OSVER}/x86_64/cuda-${OSVER}.pin \
    && mv cuda-${OSVER}.pin /etc/apt/preferences.d/cuda-repository-pin-600 \
    && wget -q ${CUDA_DEB_URL} \
    && dpkg -i ${CUDA_DEB_NAME} \
    && apt-key add ${CUDA_PUB_PATH} \
    && apt-get update \
    && apt-get -y install cuda-compiler-${CUDA_VER_MAJOR}-${CUDA_VER_MINOR} cuda-cudart-dev-${CUDA_VER_MAJOR}-${CUDA_VER_MINOR} cuda-driver-dev-${CUDA_VER_MAJOR}-${CUDA_VER_MINOR} cuda-nvrtc-dev-${CUDA_VER_MAJOR}-${CUDA_VER_MINOR} libcurand-dev-${CUDA_VER_MAJOR}-${CUDA_VER_MINOR} libnpp-dev-${CUDA_VER_MAJOR}-${CUDA_VER_MINOR} cuda-nvml-dev-${CUDA_VER_MAJOR}-${CUDA_VER_MINOR} \
    && (test -e /usr/local/cuda || ln -s /usr/local/cuda-${CUDA_VER_MAJOR}.${CUDA_VER_MINOR} /usr/local/cuda) \
    && python3 -m pip install --upgrade pip \
    && python3 -m pip install --upgrade meson ninja \
    && cmake --version \
    && meson --version \
    && which meson \
    && rm -f ${CUDA_DEB_NAME} \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
ENV CUDA_PATH=/usr/local/cuda
ENV RUSTUP_HOME=/usr/local/rustup
ENV CARGO_HOME=/usr/local/cargo
ENV PATH=/usr/local/cuda/bin:/usr/local/cargo/bin:$PATH

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --profile minimal \
    && /usr/local/cargo/bin/rustup show \
    && /usr/local/cargo/bin/cargo --version \
    && /usr/local/cargo/bin/cargo install cargo-c --version '0.10.18+cargo-0.92.0' --locked \
    && /usr/local/cargo/bin/cargo cbuild --version

RUN echo "Using build_scripts ${FFMPEG_DLL_REV}" \
    && git init "${BUILD_SCRIPTS_DIR}" \
    && git -C "${BUILD_SCRIPTS_DIR}" remote add origin "${FFMPEG_DLL_REPO}" \
    && git -C "${BUILD_SCRIPTS_DIR}" fetch --depth 1 origin "${FFMPEG_DLL_REV}" \
    && git -C "${BUILD_SCRIPTS_DIR}" checkout --detach FETCH_HEAD \
    && cd ${BUILD_SCRIPTS_DIR}/ffmpeg_dll \
    && sed -i 's/\r$//' ./build_ffmpeg_dll.sh \
    && sed -i 's/\r$//' ./build_libvmaf.sh \
    && sed -i 's#find "${SRC_DIR}" -type d -name "libjpeg-\*" | xargs -i cp -r {} ./libjpeg-turbo#cp -r "${SRC_DIR}/libjpeg-turbo-${VER_LIBJPEG_TURBO}" ./libjpeg-turbo#' ./build_ffmpeg_dll.sh \
    && grep -F 'cp -r "${SRC_DIR}/libjpeg-turbo-${VER_LIBJPEG_TURBO}" ./libjpeg-turbo' ./build_ffmpeg_dll.sh \
    && sed -i '/"-Dbuilt_in_models=true"/a\        "-Denable_float=true"' ./build_libvmaf.sh \
    && export NUMBER_OF_PROCESSORS="$(nproc)" \
    && bash ./build_ffmpeg_dll.sh --skip-src-archive --disable-pgo \
    && bash ./build_libvmaf.sh --skip-src-archive \
    && test -f "${FFMPEG_PREFIX}/lib/pkgconfig/libavutil.pc" \
    && test -f "${VMAF_PREFIX}/lib/pkgconfig/libvmaf.pc" \
    && find "${BUILD_SCRIPTS_DIR}" -mindepth 1 -maxdepth 1 ! -path "${BUILD_SCRIPTS_DIR}/ffmpeg_dll" -exec rm -rf {} + \
    && find "${BUILD_SCRIPTS_DIR}/ffmpeg_dll" -mindepth 1 -maxdepth 1 ! -path "${BUILD_SCRIPTS_DIR}/ffmpeg_dll/build_dll" ! -path "${BUILD_SCRIPTS_DIR}/ffmpeg_dll/x64" -exec rm -rf {} + \
    && find "${BUILD_SCRIPTS_DIR}/ffmpeg_dll/build_dll" -mindepth 1 -maxdepth 1 ! -path "${BUILD_SCRIPTS_DIR}/ffmpeg_dll/build_dll/x64" -exec rm -rf {} + \
    && find "${BUILD_SCRIPTS_DIR}/ffmpeg_dll/build_dll/x64" -mindepth 1 -maxdepth 1 ! -path "${BUILD_SCRIPTS_DIR}/ffmpeg_dll/build_dll/x64/build" -exec rm -rf {} + \
    && find "${BUILD_SCRIPTS_DIR}/ffmpeg_dll/x64" -mindepth 1 -maxdepth 1 ! -path "${BUILD_SCRIPTS_DIR}/ffmpeg_dll/x64/build" -exec rm -rf {} +

RUN mkdir -p "${NVENC_HEADER_DIR}" \
    && if [ ! -f "${NVENC_HEADER_DIR}/AviSynthPlus-3.7.5/avs_core/include/avisynth_c.h" ]; then \
      curl -fsSL "${AVISYNTH_HEADERS_URL}" -o /tmp/avisynth_headers.tar.gz \
      && tar -xzf /tmp/avisynth_headers.tar.gz -C "${NVENC_HEADER_DIR}" \
      && rm -f /tmp/avisynth_headers.tar.gz; \
    fi \
    && if [ ! -f "${NVENC_HEADER_DIR}/vapoursynth-R72/include/VapourSynth.h" ]; then \
      curl -fsSL "${VAPOURSYNTH_HEADERS_URL}" -o /tmp/vapoursynth_headers.tar.gz \
      && tar -xzf /tmp/vapoursynth_headers.tar.gz -C "${NVENC_HEADER_DIR}" \
      && rm -f /tmp/vapoursynth_headers.tar.gz; \
    fi \
    && if [ ! -f "${NVENC_HEADER_DIR}/vship/src/VshipAPI.h" ]; then \
      curl -fsSL "${VSHIP_HEADERS_URL}" -o /tmp/vship_headers.tar.gz \
      && tar -xzf /tmp/vship_headers.tar.gz -C "${NVENC_HEADER_DIR}" \
      && rm -f /tmp/vship_headers.tar.gz; \
    fi \
    && test -f "${NVENC_HEADER_DIR}/AviSynthPlus-3.7.5/avs_core/include/avisynth_c.h" \
    && test -f "${NVENC_HEADER_DIR}/vapoursynth-R72/include/VapourSynth.h" \
    && test -f "${NVENC_HEADER_DIR}/vship/src/VshipAPI.h"

ENV FFMPEG_PREFIX=${FFMPEG_PREFIX}
ENV VMAF_PREFIX=${VMAF_PREFIX}
ENV NVENC_HEADER_DIR=${NVENC_HEADER_DIR}
WORKDIR /work
